{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
        "tests"
    ],
    "properties": {
        "tests": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name",
                    "executable"
                ],
                "properties": {
                    "name": {
                        "description": "Name of the test",
                        "type": "string"
                    },
                    "executable": {
                        "description": "The executable to test",
                        "type": "string"
                    },
                    "returncode": {
                        "description": "The expected return code of the application given the inputs",
                        "type": "integer",
                        "default": 0
                    },
                    "input": {
                        "description": "All application inputs",
                        "type": "object",
                        "properties": {
                            "argv": {
                                "description": "Command-line arguments appended after the executable (argv[1..n])",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "env": {
                                "description": "Environment variables for the subprocess (may override or replace the parent environment)",
                                "type": "object",
                                "additionalProperties": {
                                    "type": "string"
                                },
                                "default": {}
                            },
                            "stdin": {
                                "description": "Lines written to stdin; joined with '\\n' and always newline-terminated",
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            }
                        },
                        "additionalProperties": false
                    },
                    "output": {
                        "description": "All application output",
                        "type": "object",
                        "properties": {
                            "stdout": {
                                "description": "Data coming from the application's stdout channel",
                                "$ref": "#/$defs/stream_check"
                            },
                            "stderr": {
                                "description": "Data coming from the application's stderr channel",
                                "$ref": "#/$defs/stream_check"
                            },
                            "files": {
                                "description": "The set of files produced by the application",
                                "type": "array",
                                "items": {
                                    "type": "object",
                                    "required": [
                                        "test-file"
                                    ],
                                    "properties": {
                                        "test-file": {
                                            "description": "The file to check",
                                            "type": "string"
                                        },
                                        "exists": {
                                            "description": "Whether the file is expected to exist after execution",
                                            "type": "boolean",
                                            "default": false
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            }
                        },
                        "additionalProperties": false
                    },
                    "resources": {
                        "description": "Additional files to include alongside the test context",
                        "type": "array",
                        "items": {
                            "oneOf": [
                                {
                                    "description": "Map a file into the test context with the same name",
                                    "type": "string"
                                },
                                {
                                    "description": "Map a file into the test context with a new name",
                                    "type": "object",
                                    "required": [
                                        "src",
                                        "dst"
                                    ],
                                    "properties": {
                                        "src": {
                                            "description": "Path of the file to map",
                                            "type": "string"
                                        },
                                        "dst": {
                                            "description": "Mapped file path",
                                            "type": "string"
                                        }
                                    },
                                    "additionalProperties": false
                                }
                            ]
                        },
                        "default": []
                    },
                    "script": {
                        "description": "Additional validation script to run on the application output",
                        "type": "object",
                        "required": [
                            "file"
                        ],
                        "properties": {
                            "file": {
                                "description": "Path to the validation script",
                                "type": "string"
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "$defs": {
        "stream_check": {
            "type": "object",
            "properties": {
                "text": {
                    "description": "Raw text to expect",
                    "type": "string"
                },
                "from_file": {
                    "description": "Path to a file containing the text to expect",
                    "type": "string"
                },
                "exact": {
                    "description": "If true, require exact match; otherwise normalize by removing '\\r' and trimming trailing whitespace",
                    "type": "boolean",
                    "default": false
                },
                "empty": {
                    "description": "Require the stream to be empty (overrides other expectations)",
                    "type": "boolean",
                    "default": false
                }
            },
            "additionalProperties": false,
            "anyOf": [
                {
                    "required": [
                        "empty"
                    ]
                },
                {
                    "required": [
                        "text"
                    ]
                },
                {
                    "required": [
                        "from_file"
                    ]
                }
            ]
        }
    },
    "additionalProperties": false
}